DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_nail_db
SECRET_KEY=change_this_secret_key_to_something_secure_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
REPORT_DIR=reports
MAX_UPLOAD_SIZE=5242880
# Password reset email delivery (for example, Gmail SMTP with an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
APP_BASE_URL=http://127.0.0.1:8000
